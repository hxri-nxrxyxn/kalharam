# Security keys
JWT_SECRET=super-secret-production-key

# Server Port
PORT=3000

# CORS Origins
# Comma-separated list of allowed origins. 
# For VPS deployments, add your public domains here (e.g., https://kalharam.com,https://admin.kalharam.com)
# If you are accessing via local IP from your phone, add the IP (e.g., http://192.168.1.100:5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
